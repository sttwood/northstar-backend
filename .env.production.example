# Enter in Render settings, never commit a filled copy.
APP_ENV=production
PRODUCTION_PROFILE=core
# Set images-only for bounded, re-encoded profile/community PNG/JPEG with S3/R2.
# This is not antivirus scanning; general files still require ClamAV.
UPLOAD_POLICY=scanned
COMPANY_NAME=Nexilar
COMPANY_SLUG=nexilar
ADMIN_NAME=Superadmin
SEED_DEMO=false
COOKIE_SECURE=true
APP_PUBLIC_URL=https://YOUR-PROJECT.vercel.app
API_PUBLIC_URL=https://YOUR-PROJECT.vercel.app/api
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
FRONTEND_UPSTREAM_URL=
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ENCRYPTION_KEY=
MAIL_DELIVERY=disabled
# Default scanned uploads need BOTH S3 and ClamAV; images-only needs S3/R2.
# Step-by-step free allowance setup: docs/FREE_SERVICES.md.
S3_BUCKET=
AWS_REGION=ap-southeast-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMAV_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_IMPLICIT_TLS=false
