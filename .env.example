PORT=8080
APP_ENV=development
COMPANY_NAME=Nexilar
COMPANY_SLUG=northstar
ADMIN_NAME=Superadmin
APP_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080/api
FRONTEND_UPSTREAM_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/northstar?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=./uploads
# Change these before deployment. At least 12 characters for the password.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-before-deployment
SEED_DEMO=false
COOKIE_SECURE=false

# Generate once and keep backed up: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for MFA and encrypted email jobs. Do not rotate without migrating existing encrypted data.
ENCRYPTION_KEY=

# Full production requires all providers below, HTTPS URLs and COOKIE_SECURE=true.
# Explicit core mode allows deferred providers; uploads stay disabled until S3 + scanning exist.
PRODUCTION_PROFILE=full
# Local development can use private filesystem storage without external providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Absolute path to an ignored service-account JSON file, not its contents.
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_ADDRESS=
# Local preview captures messages privately without sending. Switch to smtp with real credentials later.
MAIL_DELIVERY=preview
PREVIEW_EMAIL_DIR=./.local/mail
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_IMPLICIT_TLS=false
S3_BUCKET=
AWS_REGION=ap-southeast-1
S3_ENDPOINT=
# Prefer an instance/workload IAM role in production. Use keys only for local/provider-specific setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMAV_ADDRESS=
